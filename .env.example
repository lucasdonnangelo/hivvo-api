# Supabase PostgreSQL — copie este arquivo para .env e preencha os valores
# Connection string encontrada em: Supabase > Project Settings > Database > Connection string (URI)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# Gere com: openssl rand -hex 32
SECRET_KEY=your-secret-key-here

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

ENVIRONMENT=development

# Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Resend (email de recuperação de senha)
RESEND_API_KEY=your-resend-api-key-here

# URL do frontend (Vite dev server local ou domínio de produção)
FRONTEND_URL=http://localhost:5173

# DSN do Sentry (T-25) — OPCIONAL, setado só no deploy (ops).
# AUSENTE = no-op por design: o Sentry não inicializa e nada é enviado. Isso NÃO
# é erro — deixe vazia em dev/CI (erro de dev vai pro console).
# Encontrado em: Sentry > Project Settings > Client Keys (DSN)
SENTRY_DSN=
